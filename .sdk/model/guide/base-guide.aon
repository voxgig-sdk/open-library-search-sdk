# Guide

guide: {
  metrics: count: entity: 2
  metrics: count: path: 2
  metrics: count: method: 2

  entity: author: {
    path: "/search/authors.json": {
      op: list: method: *GET
      op: list: transform: res: *("`body.docs`")|top
    }
  }

  entity: search: {
    path: "/search.json": {
      op: list: method: *GET
      op: list: transform: res: *("`body.docs`")|top
    }
  }

}