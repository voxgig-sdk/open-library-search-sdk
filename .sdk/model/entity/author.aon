# Entity: author

main: kit: entity: author: {

  alias: field: {}

  fields: [
    {
      name: "birth_date"
      req: false
      short: "Author birth date"
      type: "`$STRING`"
    }
    {
      name: "death_date"
      req: false
      short: "Author death date"
      type: "`$STRING`"
    }
    {
      name: "key"
      req: false
      short: "Open Library author key"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Author name"
      type: "`$STRING`"
    }
    {
      name: "top_subjects"
      req: false
      short: "Top subjects associated with this author"
      type: "`$ARRAY`"
    }
    {
      name: "top_work"
      req: false
      short: "Title of top work"
      type: "`$STRING`"
    }
    {
      name: "work_count"
      req: false
      short: "Number of works by this author"
      type: "`$INTEGER`"
    }
  ]

  name: "author"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 0
                kind: "query"
                name: "offset"
                orig: "offset"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "twain"
                kind: "query"
                name: "q"
                orig: "q"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/search/authors.json"
          segments: [
            {
              lit: "search"
            }
            {
              lit: "authors.json"
            }
          ]
          select: {
            exist: [
              "limit"
              "offset"
              "q"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.docs`"
          }
        }
      ]
    }
  }



}
